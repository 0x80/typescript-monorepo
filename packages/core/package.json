{
  "name": "@repo/core",
  "version": "0.0.0",
  "description": "Code to share between backend apps/services",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    "./db-refs": {
      "types": "./dist/db-refs.d.mts",
      "default": "./dist/db-refs.mjs"
    },
    "./firebase": {
      "types": "./dist/firebase.d.mts",
      "default": "./dist/firebase.mjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.mts",
      "default": "./dist/utils/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "vitest",
    "build": "tsdown",
    "clean": "del-cli dist",
    "coverage": "vitest run --coverage "
  },
  "dependencies": {
    "@repo/common": "workspace:*",
    "@sindresorhus/is": "^8.0.0",
    "firebase-admin": "^13.8.0",
    "firebase-functions": "^7.2.5"
  },
  "devDependencies": {
    "@codecompose/typescript-config": "^3.2.0",
    "@types/node": "^25.6.0",
    "del-cli": "^7.0.0",
    "tsdown": "^0.21.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5"
  }
}
